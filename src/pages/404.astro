---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page Not Found" description="This page has moved or never existed. Try the reading tools, the teacher resources or the home page of Fiction & Fact Library instead." noindex>
  <div class="wrap">
    <div class="page-intro">
      <span class="eyebrow">404</span>
      <h1>This page is not on the shelf</h1>
      <p class="lede">We couldn’t find that page. It may have moved, or the link may be mistyped.</p>
      <div class="page-actions">
        <a class="btn primary" href="/tools/">Reading tools</a>
        <a class="btn" href="/teachers/">For teachers</a>
        <a class="btn" href="/">Home</a>
      </div>
    </div>
  </div>
</Layout>
