---
import Layout from '../layouts/Layout.astro';
import LibraryCard from '../components/LibraryCard.astro';
import LearningApps from '../components/LearningApps.astro';
import Faq from '../components/Faq.astro';
import { site } from '../lib/site.mjs';
import { flagship } from '../lib/learning-apps.mjs';
import { tools, toolGroups, toolCount, ToolCount } from '../lib/labs.mjs';

const faq: [string, string][] = [
  ['What is Fiction & Fact Library?', 'A set of free reading tools for students in grades 2 to 8 (ages about 7 to 14) and their teachers. Each tool is something to do, not just something to read, and each comes with a printable worksheet and a teacher answer key.'],
  ['What can I do here?', `There are ${toolCount} tools. ${toolGroups.map(group => `${group.name}: ${group.tools.map(tool => tool.name).join(', ')}.`).join(' ')} Each one gives feedback as you go and has a printable worksheet.`],
  ['What happened to the audiobooks?', 'They are still here, under Listen. The catalogue, the player and your saved shelf work as before, and books you saved or started on this device are still there.'],
  ['Is it free? Do students need to sign up?', 'Everything is free, with no accounts, logins or downloads. The tools run in the browser on Chromebooks, tablets, laptops and phones.'],
  ['Are there ads?', 'No. The site shows no ads of any kind.'],
  ['Does anything a student types get saved or sent anywhere?', 'No. The tools work inside the browser. Text that a student types or pastes is never sent to us, and scores stay on the device.'],
];
---
<Layout title={site.defaultTitle} description={site.defaultDescription} section="Home">
  <script is:inline slot="head">
    // The old site's home page was the audiobook catalogue, and links to a search looked like /?q=holmes.
    if (new URLSearchParams(location.search).has('q')) location.replace('/listen/' + location.search);
  </script>
  <div class="wrap">
    <section class="hero">
      <div>
        <span class="eyebrow">{site.name}</span>
        <h1>Free reading tools for <span class="hl">classrooms</span></h1>
        <p class="lede">Hands-on reading and English tools for students in grades 2–8 (ages about 7–14) and their teachers. Build a plot diagram, sort facts from opinions, tag the parts of speech or check how hard a text is to read. Each tool runs in the browser, needs no sign-up and comes with a printable worksheet.</p>
        <div class="page-actions hero-actions">
          <a class="btn primary" href="/tools/">See all {toolCount} tools</a>
          <a class="btn" href="/teachers/">For teachers</a>
        </div>
        <p class="muted">From the makers of <a href={flagship.url + '/'}>{flagship.name}</a>.</p>
      </div>
      <LibraryCard />
    </section>

    <section class="section" aria-labelledby="tools">
      <span class="eyebrow">{ToolCount} reading tools</span>
      <h2 id="tools">Tools to try</h2>
      {toolGroups.map(group => (
        <div class="tool-group">
          <h3 class="tool-group-title">{group.name}</h3>
          <p class="muted tool-group-about">{group.about}</p>
          <ul class="tool-list">
            {group.tools.map(tool => (
              <li class="card">
                <span class="eyebrow">{tool.topic}</span>
                <h4><a href={`/tools/${tool.slug}/`}>{tool.name}</a></h4>
                <p>{tool.blurb}</p>
                <p class="tool-list-links"><a href={`/tools/${tool.slug}/activity/`}>Worksheet<span class="visually-hidden">: {tool.name}</span></a></p>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section class="section" aria-labelledby="listen">
      <span class="eyebrow">Listen</span>
      <h2 id="listen">Classic books, read aloud</h2>
      <div class="listen-teaser card">
        <div>
          <p>Thousands of free audiobooks to play in your browser: classic stories, poems and non-fiction in the public domain, read aloud by LibriVox volunteers. The player remembers your place.</p>
          <p class="muted">It is a big library for all ages, not a children’s list, so teachers and parents may want to pick a title first.</p>
        </div>
        <p class="page-actions"><a class="btn primary" href="/listen/">Browse the audiobooks</a> <a class="btn" href="/favorites/">Your saved books</a></p>
      </div>
    </section>

    <section class="section" aria-labelledby="why">
      <span class="eyebrow">For teachers</span>
      <h2 id="why">Made for a class period</h2>
      <div class="why-grid">
        <div class="card"><h3>One page, ready to print</h3><p class="muted">Every tool has a one-page student worksheet and a teacher answer key.</p></div>
        <div class="card"><h3>No logins, Chromebook-ready</h3><p class="muted">Nothing to install and no accounts. Share a tool to Google Classroom in one click.</p></div>
        <div class="card"><h3>No ads</h3><p class="muted">There are no ads anywhere on the site, for students or for teachers.</p></div>
        <div class="card"><h3>Private by design</h3><p class="muted">What students type stays in their browser. We never ask for a name or an email address.</p></div>
      </div>
      <p style="margin-top:18px"><a href="/teachers/">See the classroom activities and standards →</a></p>
    </section>

    <Faq items={faq} />
    <LearningApps />
  </div>
</Layout>

<style>
  .listen-teaser { display: grid; gap: 4px 28px; align-items: center; }
  .listen-teaser p { max-width: 44rem; }
  @media (min-width: 900px) { .listen-teaser { grid-template-columns: 1fr auto; } }
</style>
