---
// The body of a classroom activity, shared by the student worksheet and the teacher answer key so the two
// cannot drift apart: the same sections render blank for students and filled in when `answers` is set.
const { act, answers = false } = Astro.props;
---
{act.sections.map(section => (
  <Fragment>
    <h2>{answers && section.type === 'questions' ? 'Answers' : section.heading}</h2>
    {section.intro && <p class="worksheet-meta">{section.intro}</p>}
    {section.type === 'passage' && <blockquote class="passage">{section.text.split('\n\n').map(paragraph => <p>{paragraph}</p>)}</blockquote>}
    {section.type === 'table' && (
      <Fragment>
        {answers && section.keyNote && <p class="worksheet-meta">{section.keyNote}</p>}
        <div class="table-wrap">
          <table class="record-table">
            <thead><tr><th scope="col">{section.rowHeader}</th>{section.columns.map(col => <th scope="col">{col}</th>)}</tr></thead>
            <tbody>
              {section.rows.map(row => (
                <tr><th scope="row">{row.label}</th>{section.columns.map(col => answers && row.values ? <td>{row.values[col]}</td> : <td class="blank" />)}</tr>
              ))}
            </tbody>
          </table>
        </div>
      </Fragment>
    )}
    {section.type === 'questions' && (
      <ol class:list={['questions', { 'key-answers': answers }]} start={section.start ?? 1}>
        {section.items.map(item => answers
          ? <li><p class="key-question">{item.q}</p><p>{item.a}</p></li>
          : <li><p>{item.q}</p><div class="write-lines" aria-hidden="true">{Array.from({ length: item.lines }, () => <span />)}</div></li>)}
      </ol>
    )}
  </Fragment>
))}
