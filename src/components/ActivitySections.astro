---
// The body of a classroom activity, shared by the student worksheet and the teacher answer key so the two
// cannot drift apart: the same sections render blank for students and filled in when `answers` is set.
import { parts, withClues, explain } from '../lib/fact-opinion.mjs';
const { act, answers = false } = Astro.props;
---
{act.sections.map(section => (
  <Fragment>
    <h2>{answers ? section.keyHeading ?? section.heading : section.heading}</h2>
    {section.intro && <p class="worksheet-meta">{section.intro}</p>}
    {section.type === 'text' && section.lines.map(line => <p class="worksheet-meta">{line}</p>)}
    {section.type === 'sort' && (
      <ol class:list={['sort-list', { 'key-answers': answers }]}>
        {section.items.map(item => answers
          ? <li><strong class="sort-answer">{item.kind === 'fact' ? 'F' : 'O'}</strong> {withClues(item).map(piece => piece.clue ? <strong class="circled">{piece.text}</strong> : piece.text)} <span class="sort-why">{`${item.kind === 'fact' ? 'Fact' : 'Opinion'}. ${item.why}`}</span></li>
          : <li><span class="sort-blank" aria-hidden="true"></span> {item.text}</li>)}
      </ol>
    )}
    {section.type === 'mixed' && (
      <ol class:list={['mixed-list', { 'key-answers': answers }]}>
        {section.items.map(item => answers
          ? <li><p>{parts(item).map(part => part.kind === 'opinion' ? <u>{withClues(item, part.start, part.start + part.text.length).map(piece => piece.clue ? <strong class="circled">{piece.text}</strong> : piece.text)}</u> : part.text)}</p><p class="sort-why">{explain(item)}</p></li>
          : <li>{item.text}</li>)}
      </ol>
    )}
    {section.type === 'passage' && <blockquote class="passage">{section.text.split('\n\n').map(paragraph => <p>{paragraph}</p>)}</blockquote>}
    {section.type === 'table' && (
      <Fragment>
        {answers && section.keyNote && <p class="worksheet-meta">{section.keyNote}</p>}
        <div class="table-wrap">
          <table class="record-table">
            <thead><tr><th scope="col">{section.rowHeader}</th>{section.columns.map(col => <th scope="col">{col}</th>)}</tr></thead>
            <tbody>
              {section.rows.map(row => (
                <tr><th scope="row">{row.label}</th>{section.columns.map(col => answers && row.values ? <td>{row.values[col]}</td> : <td class="blank" />)}</tr>
              ))}
            </tbody>
          </table>
        </div>
      </Fragment>
    )}
    {section.type === 'questions' && (
      <ol class:list={['questions', { 'key-answers': answers }]} start={section.start ?? 1}>
        {section.items.map(item => answers
          ? <li><p class="key-question">{item.q}</p><p>{item.a}</p></li>
          : <li><p>{item.q}</p><div class="write-lines" aria-hidden="true">{Array.from({ length: item.lines }, () => <span />)}</div></li>)}
      </ol>
    )}
    {/* Reading Speed Test: a passage printed line by line, with a running word count in the margin. */}
    {section.type === 'reading-speed' && (
      <div class="fluency-lines">
        {section.lines.map(line => <p class:list={[{ 'fluency-new': line.first }]}><span>{line.text}</span><span class="fluency-count">{line.count}</span></p>)}
      </div>
    )}
    {/* Main Idea and Details Game: a paragraph with its questions. The key underlines the main idea and
        strikes out the sentence that does not belong. */}
    {section.type === 'main-idea' && (
      <Fragment>
        <blockquote class="passage"><p>{section.sentences.map(sentence => answers && sentence.role === 'main' ? <><u>{sentence.text}</u>{' '}</> : answers && sentence.role === 'extra' ? <><s>{sentence.text}</s>{' '}</> : <>{sentence.text}{' '}</>)}</p></blockquote>
        <ol class:list={['questions', { 'key-answers': answers }]} start={section.start ?? 1}>
          {section.items.map(item => answers
            ? <li><p class="key-question">{item.q}</p><p>{item.a}</p></li>
            : <li><p>{item.q}</p><div class="write-lines" aria-hidden="true">{Array.from({ length: item.lines }, () => <span />)}</div></li>)}
        </ol>
      </Fragment>
    )}
  </Fragment>
))}

<style>
  /* Reading Speed Test: the fluency record sheet's passage. */
  .fluency-lines { margin: 0 0 1em; padding: 12px 16px; border: 1px solid var(--rule); border-left: 5px solid var(--hl); border-radius: 4px 10px 10px 4px; background: var(--card); font-size: 1.08rem; }
  /* The number sits level with the end of its line, also where a narrow screen wraps the line. */
  .fluency-lines p { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; margin: 0; line-height: 1.9; }
  .fluency-lines p.fluency-new:not(:first-child) { margin-top: .55em; }
  .fluency-count { flex: none; width: 5ch; padding-left: 10px; border-left: 1px solid var(--rule-strong); text-align: right; font-size: .88em; font-weight: 700; color: var(--muted); font-variant-numeric: tabular-nums; }
  @media print {
    .fluency-lines { margin-bottom: 4px; padding: 5px 9px; border: 1px solid #999; border-left-width: 3px; background: none; font-size: 11pt; }
    .fluency-lines p { margin: 0; line-height: 1.7; color: #000; }
    .fluency-lines p.fluency-new:not(:first-child) { margin-top: 4px; }
    .fluency-count { color: #333; border-color: #999; }
  }
</style>
